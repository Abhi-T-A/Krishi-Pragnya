{
  "configurations": [
    {
      "name": "Win32",
      "includePath": [
        "${workspaceFolder}/**",
        "${workspaceFolder}/windows/flutter/ephemeral/**",
        "${workspaceFolder}/windows/flutter/ephemeral/cpp_client_wrapper/include",
        "${workspaceFolder}/windows/runner",
        "${workspaceFolder}/mobile/windows/flutter/ephemeral/**",
        "${workspaceFolder}/mobile/windows/flutter/ephemeral/cpp_client_wrapper/include",
        "${workspaceFolder}/mobile/windows/runner"
      ],
      "defines": [
        "_DEBUG",
        "UNICODE",
        "_UNICODE",
        "WIN32_LEAN_AND_MEAN"
      ],
      "cStandard": "c17",
      "cppStandard": "c++17",
      "intelliSenseMode": "windows-msvc-x64"
    }
  ],
  "version": 4
}
